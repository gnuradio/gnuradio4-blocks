#ifndef GNURADIO_EXAMPLE_GRAPHS_HPP
#define GNURADIO_EXAMPLE_GRAPHS_HPP

#include <array>
#include <string_view>

// The text of every graph file in blocks/examples/graphs, embedded when the build is configured. A test reads a graph
// from here and opens no file, so it runs where the source tree is not readable.

namespace gr::examples {

/// @brief One example graph: its file name and its text.
struct ExampleGraph {
    std::string_view fileName;
    std::string_view text;
};

inline constexpr std::array kExampleGraphs{
@GR4_EXAMPLE_GRAPH_ENTRIES@
};

} // namespace gr::examples

#endif // GNURADIO_EXAMPLE_GRAPHS_HPP
