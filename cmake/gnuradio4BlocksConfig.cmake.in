@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(gnuradio4 CONFIG)
find_dependency(gnuradio4Library CONFIG)

# gnuradio4::ut-benchmark, which gnuradio4::gr-testing links, comes from core when core was built with its tests and
# from this package otherwise; core's own package config finds Boost.UT in the first case and this one in the second
set(_gnuradio4Blocks_needs_ut @GR4_EXPORT_NEEDS_UT@)
if(_gnuradio4Blocks_needs_ut)
  find_dependency(ut 2.3.1 CONFIG)
endif()
unset(_gnuradio4Blocks_needs_ut)

set(_gnuradio4Blocks_needs_Python @GR4_EXPORT_NEEDS_PYTHON@)
if(_gnuradio4Blocks_needs_Python)
  find_dependency(Python3 3.12 COMPONENTS Interpreter Development.Embed NumPy)
endif()
unset(_gnuradio4Blocks_needs_Python)

set(_gnuradio4Blocks_needs_SoapySDR @GR4_EXPORT_NEEDS_SOAPYSDR@)
if(_gnuradio4Blocks_needs_SoapySDR)
  find_dependency(SoapySDR 0.8 CONFIG)
endif()
unset(_gnuradio4Blocks_needs_SoapySDR)

# the zeromq family, and the network family's ZMQ transports, link cppzmq, whose package finds libzmq in turn
set(_gnuradio4Blocks_needs_cppzmq @GR4_EXPORT_NEEDS_CPPZMQ@)
if(_gnuradio4Blocks_needs_cppzmq)
  find_dependency(cppzmq 4.7 CONFIG)
endif()
unset(_gnuradio4Blocks_needs_cppzmq)

# the audio family links libsoundio::libsoundio, defined by the find module installed beside this file
set(_gnuradio4Blocks_needs_libsoundio @GR4_EXPORT_NEEDS_LIBSOUNDIO@)
if(_gnuradio4Blocks_needs_libsoundio)
  list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  find_dependency(libsoundio 2.0 MODULE)
  list(POP_FRONT CMAKE_MODULE_PATH)
endif()
unset(_gnuradio4Blocks_needs_libsoundio)

include("${CMAKE_CURRENT_LIST_DIR}/gnuradio4Targets.cmake")

check_required_components(gnuradio4Blocks)
