@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(gnuradio4 CONFIG)
find_dependency(gnuradio4Library CONFIG)

set(_gnuradio4Blocks_needs_SoapySDR @GR4_EXPORT_NEEDS_SOAPYSDR@)
if(_gnuradio4Blocks_needs_SoapySDR)
  find_dependency(SoapySDR CONFIG)
endif()
unset(_gnuradio4Blocks_needs_SoapySDR)

set(_gnuradio4Blocks_needs_ZeroMQ @GR4_EXPORT_NEEDS_ZEROMQ@)
if(_gnuradio4Blocks_needs_ZeroMQ)
  set(_gnuradio4Blocks_cppzmq_provider "@GR4_ZEROMQ_CPPZMQ_PROVIDER@")
  if(_gnuradio4Blocks_cppzmq_provider STREQUAL "cmake")
    find_dependency(cppzmq CONFIG)
  else()
    find_dependency(PkgConfig)
    pkg_check_modules(CPPZMQ REQUIRED IMPORTED_TARGET cppzmq)
  endif()
  unset(_gnuradio4Blocks_cppzmq_provider)
endif()
unset(_gnuradio4Blocks_needs_ZeroMQ)

# An exported interface may name only targets the consumer can also define. gnuradio4::gr-network names the imported
# target this project's configure created for libzmq, so a consumer linking it fails at generate time -- "links to
# target PkgConfig::GR4_LIBZMQ but the target was not found" -- unless the same target exists there. It is rebuilt here
# under the same name from the same pkg-config module rather than baked into the export as this machine's library path:
# a consumer's own libzmq, found the consumer's own way, is the one it should link.
#
# Not REQUIRED: only the network family names libzmq, and a consumer of any other family must not be refused the whole
# package for a library it never links. Where libzmq is genuinely absent the target stays undefined and that consumer
# meets the generate-time error again, which the message below explains ahead of it.
if(@GR4_EXPORT_NEEDS_LIBZMQ@ AND NOT TARGET PkgConfig::GR4_LIBZMQ)
  find_dependency(PkgConfig)
  pkg_check_modules(GR4_LIBZMQ QUIET IMPORTED_TARGET libzmq)
  if(NOT TARGET PkgConfig::GR4_LIBZMQ)
    message(STATUS "gnuradio4Blocks: libzmq was not found by pkg-config; gnuradio4::gr-network and"
                   " gnuradio4::GrNetworkBlocksShared cannot be linked from this install")
  endif()
endif()

# The same for cppzmq, which the network family names for a second reason: the C++ binding is header-only, so the
# target is also the only statement of which directory `#include <zmq.hpp>` resolves in. libzmq's own include directory
# answers for it only where the two packages happen to share one; where cppzmq lives in its own prefix a consumer that
# is told nothing configures and then fails in the compiler. Found here by the provider this install was built with,
# because that is the one whose target name the export carries.
#
# Where that provider was a loose header there is no target name in the export and nothing to re-create: a header's
# directory is a fact about the machine that built the install and about no other, so publishing it would hand a
# relocated consumer a path that resolves only by coincidence. The consumer's own machine is searched instead, package
# first, and whatever answers is attached to the imported target once the targets file below has defined it.
set(_gnuradio4Blocks_cppzmq_link "")
set(_gnuradio4Blocks_cppzmq_include "")
set(_gnuradio4Blocks_needs_cppzmq @GR4_EXPORT_NEEDS_CPPZMQ@)
if(_gnuradio4Blocks_needs_cppzmq)
  set(_gnuradio4Blocks_cppzmq_provider "@GR4_NETWORK_CPPZMQ_PROVIDER@")
  if(_gnuradio4Blocks_cppzmq_provider STREQUAL "cmake")
    if(NOT TARGET cppzmq)
      find_package(cppzmq CONFIG QUIET)
    endif()
    if(NOT TARGET cppzmq)
      message(STATUS "gnuradio4Blocks: the cppzmq package was not found; gnuradio4::gr-network and"
                     " gnuradio4::GrNetworkBlocksShared cannot be linked from this install")
    endif()
  elseif(_gnuradio4Blocks_cppzmq_provider STREQUAL "pkgconfig")
    if(NOT TARGET PkgConfig::GR4_CPPZMQ)
      find_dependency(PkgConfig)
      pkg_check_modules(GR4_CPPZMQ QUIET IMPORTED_TARGET cppzmq)
    endif()
    if(NOT TARGET PkgConfig::GR4_CPPZMQ)
      message(STATUS "gnuradio4Blocks: cppzmq was not found by pkg-config; gnuradio4::gr-network and"
                     " gnuradio4::GrNetworkBlocksShared cannot be linked from this install")
    endif()
  else()
    if(NOT TARGET cppzmq)
      find_package(cppzmq CONFIG QUIET)
    endif()
    if(NOT TARGET PkgConfig::GR4_CPPZMQ AND NOT TARGET cppzmq)
      find_dependency(PkgConfig)
      pkg_check_modules(GR4_CPPZMQ QUIET IMPORTED_TARGET cppzmq)
    endif()
    if(TARGET cppzmq)
      set(_gnuradio4Blocks_cppzmq_link cppzmq)
    elseif(TARGET PkgConfig::GR4_CPPZMQ)
      set(_gnuradio4Blocks_cppzmq_link PkgConfig::GR4_CPPZMQ)
    else()
      find_path(GR4_CPPZMQ_INCLUDE_DIR zmq.hpp)
      if(GR4_CPPZMQ_INCLUDE_DIR)
        set(_gnuradio4Blocks_cppzmq_include "${GR4_CPPZMQ_INCLUDE_DIR}")
      else()
        message(STATUS "gnuradio4Blocks: cppzmq was not found as a package, by pkg-config or as a header on this"
                       " machine; gnuradio4::gr-network and gnuradio4::GrNetworkBlocksShared cannot compile"
                       " <zmq.hpp> from this install")
      endif()
    endif()
  endif()
  unset(_gnuradio4Blocks_cppzmq_provider)
endif()
unset(_gnuradio4Blocks_needs_cppzmq)

# The audio family links gnuradio4::gr-libsoundio, whose whole content is libsoundio's library and the directory
# <soundio/soundio.h> resolves in. libsoundio ships no package files of any kind, so both of those are what a
# find_library and a find_path answered on the machine that built this install and are a statement about no other
# machine; published, they would hand a relocated consumer paths that resolve only by coincidence. The same two
# searches run here instead, and what they answer is attached below to the imported target.
#
# Not REQUIRED: only the audio family names libsoundio, and a consumer of any other family must not be refused the
# whole package for a library it never links. Where libsoundio is absent the imported target carries nothing and that
# consumer meets the compiler's own error at <soundio/soundio.h>, after this message.
set(_gnuradio4Blocks_needs_libsoundio @GR4_EXPORT_NEEDS_LIBSOUNDIO@)
if(_gnuradio4Blocks_needs_libsoundio)
  find_library(GR4_LIBSOUNDIO_LIBRARY soundio)
  find_path(GR4_LIBSOUNDIO_INCLUDE_DIR soundio/soundio.h)
  if(NOT GR4_LIBSOUNDIO_LIBRARY OR NOT GR4_LIBSOUNDIO_INCLUDE_DIR)
    message(STATUS "gnuradio4Blocks: libsoundio was not found on this machine; gnuradio4::gr-audio and"
                   " gnuradio4::GrAudioBlocksShared cannot compile <soundio/soundio.h> or link from this install")
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/gnuradio4Targets.cmake")

# The imported target exists only now, so this is where a cppzmq resolved above for a loose-header install is attached
# to it. An imported target's usage requirements may be appended to; both include properties are set because the second
# is what keeps the binding's own warnings out of a consumer's build, as SYSTEM INTERFACE did in the tree that built it.
if(TARGET gnuradio4::gr-network AND _gnuradio4Blocks_cppzmq_link)
  set_property(TARGET gnuradio4::gr-network APPEND PROPERTY INTERFACE_LINK_LIBRARIES "${_gnuradio4Blocks_cppzmq_link}")
elseif(TARGET gnuradio4::gr-network AND _gnuradio4Blocks_cppzmq_include)
  set_property(TARGET gnuradio4::gr-network APPEND PROPERTY INTERFACE_INCLUDE_DIRECTORIES
                                                            "${_gnuradio4Blocks_cppzmq_include}")
  set_property(TARGET gnuradio4::gr-network APPEND PROPERTY INTERFACE_SYSTEM_INCLUDE_DIRECTORIES
                                                            "${_gnuradio4Blocks_cppzmq_include}")
endif()
unset(_gnuradio4Blocks_cppzmq_link)
unset(_gnuradio4Blocks_cppzmq_include)

# The imported target exists only now, so this is where what was found above is attached to it. An imported target's
# usage requirements may be appended to; both include properties are set because the second is what keeps libsoundio's
# own header out of a consumer's warnings, as SYSTEM INTERFACE does in the tree that built the install.
if(_gnuradio4Blocks_needs_libsoundio
   AND TARGET gnuradio4::gr-libsoundio
   AND GR4_LIBSOUNDIO_LIBRARY
   AND GR4_LIBSOUNDIO_INCLUDE_DIR)
  set_property(TARGET gnuradio4::gr-libsoundio APPEND PROPERTY INTERFACE_INCLUDE_DIRECTORIES
                                                               "${GR4_LIBSOUNDIO_INCLUDE_DIR}")
  set_property(TARGET gnuradio4::gr-libsoundio APPEND PROPERTY INTERFACE_SYSTEM_INCLUDE_DIRECTORIES
                                                               "${GR4_LIBSOUNDIO_INCLUDE_DIR}")
  set_property(TARGET gnuradio4::gr-libsoundio APPEND PROPERTY INTERFACE_LINK_LIBRARIES "${GR4_LIBSOUNDIO_LIBRARY}")
endif()
unset(_gnuradio4Blocks_needs_libsoundio)

check_required_components(gnuradio4Blocks)
