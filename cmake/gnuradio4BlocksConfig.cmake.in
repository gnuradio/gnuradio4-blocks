@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(gnuradio4 CONFIG)
find_dependency(gnuradio4Library CONFIG)

set(_gnuradio4Blocks_needs_SoapySDR @GR4_EXPORT_NEEDS_SOAPYSDR@)
if(_gnuradio4Blocks_needs_SoapySDR)
  find_dependency(SoapySDR CONFIG)
endif()
unset(_gnuradio4Blocks_needs_SoapySDR)

include("${CMAKE_CURRENT_LIST_DIR}/gnuradio4Targets.cmake")

check_required_components(gnuradio4Blocks)
